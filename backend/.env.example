DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DB_SCHEMA=faccupoint
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECRET_KEY=troque-este-segredo-em-producao
DISABLE_DOCS=1

# Limites por processo; use somente um worker com sessoes em memoria.
HTTP_REQUESTS_PER_MINUTE=3000
HTTP_GLOBAL_REQUESTS_PER_MINUTE=10000
AUTH_REQUESTS_PER_MINUTE=120
HTTP_MAX_BODY_BYTES=65536
HTTP_BODY_TIMEOUT_SECONDS=15
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_IP=300
WS_CONNECTIONS_PER_MINUTE=600
WS_MESSAGES_PER_MINUTE=120
WS_MAX_MESSAGE_BYTES=16384
WS_ALLOW_BINARY=0

# opcional, para enviar relatorio ao professor no fim da aula
# recomendado no Render free: API HTTPS do Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ou, se preferir manter o nome usado no painel/env:
# resend=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FaccuPoint <onboarding@resend.dev>

# fallback local via SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=email-da-aplicacao@gmail.com
EMAIL_PASSWORD=senha-de-app
EMAIL_FROM=FaccuPoint <email-da-aplicacao@gmail.com>
EMAIL_STARTTLS=1

# Gmail API via HTTPS: ver ferramentas/GMAIL_SETUP.md
EMAIL_PROVIDER=auto
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=faccupoint@gmail.com
